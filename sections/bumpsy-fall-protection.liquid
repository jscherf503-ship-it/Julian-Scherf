{%- liquid
  assign bumpsy_product = section.settings.product | default: product
  assign selected_variant = bumpsy_product.selected_or_first_available_variant
-%}

<style>
  .bumpsy-fp {
    --cs-navy: #14162B;
    --cs-navy-2: #1E2142;
    --cs-mint: #4ECDC4;
    --cs-coral: #FF6B81;
    --cs-lavender: #A78BFA;
    --cs-cream: #FFF9F2;
    background: var(--cs-cream);
    color: var(--cs-navy);
    padding: 2rem 1rem 3rem;
  }
  .bumpsy-fp * { box-sizing: border-box; }
  .bumpsy-fp-inner { max-width: 1180px; margin: 0 auto; }
  .bumpsy-fp-empty {
    padding: 2rem; text-align: center; border: 1px dashed var(--cs-navy);
    border-radius: 12px;
  }

  /* ---- top grid: gallery + buybox ---- */
  .bumpsy-fp-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 990px) {
    .bumpsy-fp-top { grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: start; }
  }

  /* gallery */
  .bumpsy-fp-gallery { position: relative; }
  .bumpsy-fp-main {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    border-radius: 16px;
    background: #fff;
    scrollbar-width: none;
  }
  .bumpsy-fp-main::-webkit-scrollbar { display: none; }
  .bumpsy-fp-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
  }
  .bumpsy-fp-slide img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .bumpsy-fp-thumbs {
    display: flex; gap: .5rem; margin-top: .75rem;
    overflow-x: auto; scrollbar-width: none;
  }
  .bumpsy-fp-thumbs::-webkit-scrollbar { display: none; }
  .bumpsy-fp-thumb {
    flex: 0 0 64px; width: 64px; height: 64px; border-radius: 10px;
    overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer;
    background: #fff;
  }
  .bumpsy-fp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bumpsy-fp-thumb.is-active { border-color: var(--cs-mint); }

  /* buybox */
  .bumpsy-fp-eyebrow {
    display: inline-block; font-size: .8rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: var(--cs-coral); margin-bottom: .4rem;
  }
  .bumpsy-fp-title { font-size: clamp(1.5rem, 4vw, 2.2rem); line-height: 1.15; margin: 0 0 .5rem; }
  .bumpsy-fp-subheading { font-size: 1rem; opacity: .85; margin: 0 0 1rem; }

  .bumpsy-fp-features {
    display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem;
  }
  .bumpsy-fp-feature {
    display: flex; align-items: center; gap: .4rem;
    background: #fff; border-radius: 999px; padding: .4rem .8rem;
    font-size: .82rem; font-weight: 600;
  }

  .bumpsy-fp-option-group { margin-bottom: 1.25rem; }
  .bumpsy-fp-option-label { font-weight: 700; font-size: .9rem; margin-bottom: .5rem; display: block; }
  .bumpsy-fp-option-values { display: flex; flex-wrap: wrap; gap: .5rem; }
  .bumpsy-fp-swatch {
    border: 2px solid var(--cs-navy-2); background: #fff; color: var(--cs-navy);
    border-radius: 999px; padding: .5rem 1rem; font-size: .9rem; font-weight: 600;
    cursor: pointer; transition: background .15s, color .15s;
  }
  .bumpsy-fp-swatch[aria-pressed="true"] { background: var(--cs-navy-2); color: #fff; }
  .bumpsy-fp-swatch:disabled { opacity: .4; cursor: not-allowed; }

  .bumpsy-fp-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-bottom: 1rem; }
  .bumpsy-fp-tier {
    position: relative; text-align: left; border: 2px solid var(--cs-navy-2); background: #fff;
    border-radius: 14px; padding: .8rem .6rem; cursor: pointer; font-family: inherit;
  }
  .bumpsy-fp-tier[aria-pressed="true"] {
    border-color: var(--cs-mint); background: rgba(78, 205, 196, .12);
  }
  .bumpsy-fp-tier-badge {
    display: inline-block; background: var(--cs-coral); color: #fff; font-size: .68rem;
    font-weight: 700; border-radius: 999px; padding: .15rem .5rem; margin-bottom: .35rem;
  }
  .bumpsy-fp-tier-qty { font-weight: 700; font-size: .95rem; display: block; }
  .bumpsy-fp-tier-price { font-size: 1.05rem; font-weight: 800; display: block; margin-top: .15rem; }
  .bumpsy-fp-tier-savings { font-size: .72rem; color: var(--cs-navy); opacity: .75; display: block; margin-top: .1rem; }

  .bumpsy-fp-unit-price { font-size: .85rem; opacity: .8; margin-bottom: .9rem; }

  .bumpsy-fp-cta {
    width: 100%; background: var(--cs-mint); color: var(--cs-navy); border: none;
    border-radius: 999px; padding: 1rem 1.2rem; font-size: 1.05rem; font-weight: 800;
    cursor: pointer;
  }
  .bumpsy-fp-cta:disabled { background: #ccc; cursor: not-allowed; }

  .bumpsy-fp-legal { font-size: .75rem; opacity: .75; margin-top: .6rem; line-height: 1.4; }

  .bumpsy-fp-trustbar {
    display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1rem; padding-top: 1rem;
    border-top: 1px solid rgba(20,22,43,.12);
  }
  .bumpsy-fp-trust-item { display: flex; align-items: center; gap: .4rem; font-size: .8rem; font-weight: 600; }
  .bumpsy-fp-trust-item svg { flex: 0 0 auto; }

  /* content sections */
  .bumpsy-fp-section { margin-top: 3.5rem; }
  .bumpsy-fp-section-heading {
    font-size: clamp(1.3rem, 3vw, 1.8rem); margin: 0 0 1.5rem; text-align: center;
  }
  .bumpsy-fp-objection-intro { max-width: 640px; margin: 0 auto 1.5rem; text-align: center; opacity: .9; }
  .bumpsy-fp-tips { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 750px) { .bumpsy-fp-tips { grid-template-columns: repeat(3, 1fr); } }
  .bumpsy-fp-tip { background: #fff; border-radius: 14px; padding: 1.25rem; }
  .bumpsy-fp-tip-icon { font-size: 1.6rem; display: block; margin-bottom: .5rem; }
  .bumpsy-fp-tip-title { font-weight: 700; margin: 0 0 .35rem; }
  .bumpsy-fp-tip-text { font-size: .9rem; opacity: .85; margin: 0; }

  .bumpsy-fp-capabilities { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 750px) { .bumpsy-fp-capabilities { grid-template-columns: 1fr 1fr; } }
  .bumpsy-fp-cap-card { border-radius: 14px; padding: 1.5rem; }
  .bumpsy-fp-cap-card.is-yes { background: rgba(78, 205, 196, .15); }
  .bumpsy-fp-cap-card.is-no { background: rgba(255, 107, 129, .12); }
  .bumpsy-fp-cap-card h3 { margin: 0 0 .9rem; font-size: 1.05rem; }
  .bumpsy-fp-cap-card ul { margin: 0; padding: 0; list-style: none; }
  .bumpsy-fp-cap-card li { display: flex; gap: .5rem; margin-bottom: .6rem; font-size: .92rem; line-height: 1.4; }
  .bumpsy-fp-cap-card li::before { flex: 0 0 auto; font-weight: 800; }
  .bumpsy-fp-cap-card.is-yes li::before { content: "✓"; color: #0d8f85; }
  .bumpsy-fp-cap-card.is-no li::before { content: "✕"; color: #c9425a; }

  .bumpsy-fp-video-wrap { max-width: 640px; margin: 0 auto; text-align: center; }
  .bumpsy-fp-video-wrap > div, .bumpsy-fp-video-wrap deferred-media, .bumpsy-fp-video-wrap video {
    border-radius: 16px; overflow: hidden; margin-top: 1rem;
  }
  .bumpsy-fp-video-text { opacity: .85; font-size: .95rem; }

  .bumpsy-fp-faq { max-width: 760px; margin: 0 auto; }
  .bumpsy-fp-faq-item {
    background: #fff; border-radius: 12px; padding: .25rem 1.1rem; margin-bottom: .75rem;
  }
  .bumpsy-fp-faq-item summary {
    cursor: pointer; padding: 1rem 0; font-weight: 700; list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .bumpsy-fp-faq-item summary::-webkit-details-marker { display: none; }
  .bumpsy-fp-faq-item summary::after {
    content: "+"; font-size: 1.3rem; font-weight: 400; color: var(--cs-coral); flex: 0 0 auto;
  }
  .bumpsy-fp-faq-item[open] summary::after { content: "–"; }
  .bumpsy-fp-faq-answer { padding: 0 0 1rem; font-size: .92rem; opacity: .9; line-height: 1.5; }
</style>

<div
  class="bumpsy-fp"
  data-bumpsy-root
  data-section-id="{{ section.id }}"
  data-add-to-cart-text="{{ section.settings.add_to_cart_text | escape }}"
  data-sold-out-text="{{ section.settings.sold_out_text | escape }}"
>
  <div class="bumpsy-fp-inner">
    {%- if bumpsy_product == blank -%}
      <div class="bumpsy-fp-empty">
        Bitte weise dieser Section ein Produkt zu oder platziere sie auf einer Produktseite.
      </div>
    {%- else -%}

      <div class="bumpsy-fp-top">
        {%- comment -%} Gallery {%- endcomment -%}
        <div class="bumpsy-fp-gallery">
          <div class="bumpsy-fp-main" data-bumpsy-main>
            {%- for image in bumpsy_product.images -%}
              <div class="bumpsy-fp-slide" data-media-id="{{ image.id }}" data-index="{{ forloop.index0 }}">
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 990px) 560px, 100vw"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="1200" height="1200"
                  alt="{{ image.alt | escape | default: bumpsy_product.title }}"
                >
              </div>
            {%- else -%}
              <div class="bumpsy-fp-slide">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endfor -%}
          </div>

          {%- if bumpsy_product.images.size > 1 -%}
            <div class="bumpsy-fp-thumbs" data-bumpsy-thumbs>
              {%- for image in bumpsy_product.images -%}
                <button
                  type="button"
                  class="bumpsy-fp-thumb{% if forloop.first %} is-active{% endif %}"
                  data-media-id="{{ image.id }}"
                  data-index="{{ forloop.index0 }}"
                  aria-label="Bild {{ forloop.index }} anzeigen"
                >
                  <img src="{{ image | image_url: width: 160 }}" loading="lazy" alt="" width="64" height="64">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Buybox {%- endcomment -%}
        <div class="bumpsy-fp-buybox">
          {%- if section.settings.eyebrow_text != blank -%}
            <span class="bumpsy-fp-eyebrow">{{ section.settings.eyebrow_text }}</span>
          {%- endif -%}
          <h2 class="bumpsy-fp-title">{{ bumpsy_product.title }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="bumpsy-fp-subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="bumpsy-fp-features">
              {%- for block in section.blocks -%}
                {%- if block.type == 'feature' -%}
                  <span class="bumpsy-fp-feature" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                    {{ block.settings.text }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <p class="bumpsy-fp-unit-price" data-bumpsy-unit-price>
            Einzelpreis: {{ selected_variant.price | money }}
          </p>

          {%- comment -%} Variant / design options {%- endcomment -%}
          {%- for option in bumpsy_product.options_with_values -%}
            <div class="bumpsy-fp-option-group" data-bumpsy-option-group data-option-index="{{ forloop.index0 }}">
              <span class="bumpsy-fp-option-label">{{ option.name }}</span>
              <div class="bumpsy-fp-option-values" role="group" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="bumpsy-fp-swatch"
                    data-bumpsy-option-value
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                    aria-pressed="{% if selected_variant.options[forloop.parentloop.index0] == value %}true{% else %}false{% endif %}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          {%- comment -%} Hidden variant data used by JS to resolve id/price/image per option combo {%- endcomment -%}
          <div hidden data-bumpsy-variant-data>
            {%- for variant in bumpsy_product.variants -%}
              <span
                data-variant-id="{{ variant.id }}"
                data-option1="{{ variant.option1 | escape }}"
                data-option2="{{ variant.option2 | escape }}"
                data-option3="{{ variant.option3 | escape }}"
                data-available="{{ variant.available }}"
                data-price="{{ variant.price | money }}"
                data-media-id="{{ variant.featured_media.id }}"
              ></span>
            {%- endfor -%}
          </div>

          {%- comment -%} Bundle tier picker {%- endcomment -%}
          {%- assign tier_blocks = section.blocks | where: 'type', 'bundle_tier' -%}
          {%- assign preselected_tier = tier_blocks.first -%}
          {%- for block in tier_blocks -%}
            {%- if block.settings.preselected -%}
              {%- assign preselected_tier = block -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if tier_blocks.size > 0 -%}
            <div class="bumpsy-fp-option-group">
              <span class="bumpsy-fp-option-label">Set wählen</span>
              <div class="bumpsy-fp-tiers" role="group" aria-label="Set-Auswahl" data-bumpsy-tiers>
                {%- for block in tier_blocks -%}
                  <button
                    type="button"
                    class="bumpsy-fp-tier"
                    data-bumpsy-tier
                    data-qty="{{ block.settings.quantity }}"
                    data-price="{{ block.settings.price | escape }}"
                    aria-pressed="{% if block.settings.preselected %}true{% else %}false{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.badge != blank -%}
                      <span class="bumpsy-fp-tier-badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                    <span class="bumpsy-fp-tier-qty">{{ block.settings.quantity }}x</span>
                    <span class="bumpsy-fp-tier-price">{{ block.settings.price }}</span>
                    {%- if block.settings.savings != blank -%}
                      <span class="bumpsy-fp-tier-savings">{{ block.settings.savings }}</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <form method="post" action="{{ routes.cart_add_url }}" data-bumpsy-form>
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-bumpsy-variant-input>
            <input type="hidden" name="quantity" value="{% if preselected_tier %}{{ preselected_tier.settings.quantity }}{% else %}1{% endif %}" data-bumpsy-qty-input>
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <button
              type="submit"
              class="bumpsy-fp-cta"
              data-bumpsy-cta
              {% unless selected_variant.available %}disabled{% endunless %}
            >
              {%- if selected_variant.available -%}
                {{ section.settings.add_to_cart_text }}
              {%- else -%}
                {{ section.settings.sold_out_text }}
              {%- endif -%}
            </button>
          </form>

          <p class="bumpsy-fp-legal">
            {%- if section.settings.age_notice != blank -%}{{ section.settings.age_notice }}<br>{%- endif -%}
            {%- if section.settings.price_legal_notice != blank -%}{{ section.settings.price_legal_notice }}{%- endif -%}
          </p>

          <div class="bumpsy-fp-trustbar">
            {%- if section.settings.trust_en71 != blank -%}
              <span class="bumpsy-fp-trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ section.settings.trust_en71 }}
              </span>
            {%- endif -%}
            {%- if section.settings.trust_shipping != blank -%}
              <span class="bumpsy-fp-trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="1" y="6" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.8"/><path d="M15 10h4l3 3.5V17h-7v-7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="6" cy="19" r="1.6" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="19" r="1.6" stroke="currentColor" stroke-width="1.6"/></svg>
                {{ section.settings.trust_shipping }}
              </span>
            {%- endif -%}
            {%- if section.settings.trust_returns != blank -%}
              <span class="bumpsy-fp-trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 1 1 2.6 5.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 8v4h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ section.settings.trust_returns }}
              </span>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Objection: will my child even wear this voluntarily {%- endcomment -%}
      {%- assign tip_blocks = section.blocks | where: 'type', 'acceptance_tip' -%}
      {%- if section.settings.objection_heading != blank -%}
        <div class="bumpsy-fp-section">
          <h2 class="bumpsy-fp-section-heading">{{ section.settings.objection_heading }}</h2>
          {%- if section.settings.objection_intro != blank -%}
            <div class="bumpsy-fp-objection-intro">{{ section.settings.objection_intro }}</div>
          {%- endif -%}
          {%- if tip_blocks.size > 0 -%}
            <div class="bumpsy-fp-tips">
              {%- for block in tip_blocks -%}
                <div class="bumpsy-fp-tip" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="bumpsy-fp-tip-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  <p class="bumpsy-fp-tip-title">{{ block.settings.title }}</p>
                  <p class="bumpsy-fp-tip-text">{{ block.settings.text }}</p>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Honest capability boundaries {%- endcomment -%}
      {%- if section.settings.capabilities_heading != blank -%}
        <div class="bumpsy-fp-section">
          <h2 class="bumpsy-fp-section-heading">{{ section.settings.capabilities_heading }}</h2>
          <div class="bumpsy-fp-capabilities">
            <div class="bumpsy-fp-cap-card is-yes">
              <h3>{{ section.settings.capabilities_yes_heading }}</h3>
              <ul>
                {%- assign yes_items = section.settings.capabilities_yes | newline_to_br | split: '<br />' -%}
                {%- for item in yes_items -%}
                  {%- assign trimmed = item | strip -%}
                  {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
            <div class="bumpsy-fp-cap-card is-no">
              <h3>{{ section.settings.capabilities_no_heading }}</h3>
              <ul>
                {%- assign no_items = section.settings.capabilities_no | newline_to_br | split: '<br />' -%}
                {%- for item in no_items -%}
                  {%- assign trimmed = item | strip -%}
                  {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Demo / fitting video {%- endcomment -%}
      {%- if section.settings.demo_video != blank -%}
        <div class="bumpsy-fp-section">
          <div class="bumpsy-fp-video-wrap">
            {%- if section.settings.video_heading != blank -%}
              <h2 class="bumpsy-fp-section-heading">{{ section.settings.video_heading }}</h2>
            {%- endif -%}
            {{ section.settings.demo_video | video_tag: image_size: '1100x', controls: true, loop: false, muted: false }}
            {%- if section.settings.video_text != blank -%}
              <p class="bumpsy-fp-video-text">{{ section.settings.video_text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} FAQ {%- endcomment -%}
      {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
      {%- if faq_blocks.size > 0 -%}
        <div class="bumpsy-fp-section">
          {%- if section.settings.faq_heading != blank -%}
            <h2 class="bumpsy-fp-section-heading">{{ section.settings.faq_heading }}</h2>
          {%- endif -%}
          <div class="bumpsy-fp-faq">
            {%- for block in faq_blocks -%}
              <details class="bumpsy-fp-faq-item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="bumpsy-fp-faq-answer">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initBumpsySection(root) {
      if (!root || root.dataset.bumpsyInitialized === 'true') return;
      root.dataset.bumpsyInitialized = 'true';

      var mainGallery = root.querySelector('[data-bumpsy-main]');
      var thumbButtons = root.querySelectorAll('[data-bumpsy-thumbs] .bumpsy-fp-thumb');
      var optionGroups = root.querySelectorAll('[data-bumpsy-option-group]');
      var variantNodes = root.querySelectorAll('[data-bumpsy-variant-data] span');
      var tierButtons = root.querySelectorAll('[data-bumpsy-tier]');
      var variantInput = root.querySelector('[data-bumpsy-variant-input]');
      var qtyInput = root.querySelector('[data-bumpsy-qty-input]');
      var ctaButton = root.querySelector('[data-bumpsy-cta]');
      var unitPriceEl = root.querySelector('[data-bumpsy-unit-price]');
      var optionCount = optionGroups.length;

      var variants = Array.prototype.map.call(variantNodes, function (node) {
        return {
          id: node.getAttribute('data-variant-id'),
          options: [node.getAttribute('data-option1'), node.getAttribute('data-option2'), node.getAttribute('data-option3')],
          available: node.getAttribute('data-available') === 'true',
          price: node.getAttribute('data-price'),
          mediaId: node.getAttribute('data-media-id')
        };
      });

      var selectedOptions = [];
      optionGroups.forEach(function (group) {
        var pressed = group.querySelector('.bumpsy-fp-swatch[aria-pressed="true"]');
        var index = parseInt(group.getAttribute('data-option-index'), 10);
        selectedOptions[index] = pressed ? pressed.getAttribute('data-value') : null;
      });

      function findVariant() {
        return variants.filter(function (v) {
          for (var i = 0; i < optionCount; i++) {
            if (selectedOptions[i] != null && v.options[i] !== selectedOptions[i]) return false;
          }
          return true;
        })[0];
      }

      function scrollToMedia(mediaId) {
        if (!mediaId || !mainGallery) return;
        var slide = mainGallery.querySelector('[data-media-id="' + mediaId + '"]');
        if (!slide) return;
        mainGallery.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
        thumbButtons.forEach(function (btn) {
          btn.classList.toggle('is-active', btn.getAttribute('data-media-id') === mediaId);
        });
      }

      function updateForVariant() {
        var variant = findVariant();
        if (!variant) return;
        if (variantInput) variantInput.value = variant.id;
        if (unitPriceEl && variant.price) {
          unitPriceEl.textContent = unitPriceEl.textContent.replace(/[\d.,]+\s*€/, variant.price);
        }
        if (ctaButton) {
          ctaButton.disabled = !variant.available;
          ctaButton.textContent = variant.available
            ? (root.getAttribute('data-add-to-cart-text') || ctaButton.textContent)
            : (root.getAttribute('data-sold-out-text') || ctaButton.textContent);
        }
        if (variant.mediaId) scrollToMedia(variant.mediaId);
      }

      optionGroups.forEach(function (group) {
        var buttons = group.querySelectorAll('[data-bumpsy-option-value]');
        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            var index = parseInt(button.getAttribute('data-option-index'), 10);
            buttons.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
            button.setAttribute('aria-pressed', 'true');
            selectedOptions[index] = button.getAttribute('data-value');
            updateForVariant();
          });
        });
      });

      if (mainGallery) {
        mainGallery.addEventListener('scroll', function () {
          var slides = mainGallery.querySelectorAll('.bumpsy-fp-slide');
          var closest = null;
          var closestDist = Infinity;
          slides.forEach(function (slide) {
            var dist = Math.abs(slide.offsetLeft - mainGallery.scrollLeft);
            if (dist < closestDist) { closestDist = dist; closest = slide; }
          });
          if (closest) {
            var mediaId = closest.getAttribute('data-media-id');
            thumbButtons.forEach(function (btn) {
              btn.classList.toggle('is-active', btn.getAttribute('data-media-id') === mediaId);
            });
          }
        }, { passive: true });
      }

      thumbButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          scrollToMedia(btn.getAttribute('data-media-id'));
        });
      });

      tierButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          tierButtons.forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
          btn.setAttribute('aria-pressed', 'true');
          if (qtyInput) qtyInput.value = btn.getAttribute('data-qty');
        });
      });
    }

    function initAll() {
      document.querySelectorAll('[data-bumpsy-root]').forEach(initBumpsySection);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector ? event.target.querySelector('[data-bumpsy-root]') : null;
      if (root) initBumpsySection(root);
    });
  })();
</script>

